model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation PBI_ProTooling = ["DevMode"]

	annotation PBI_QueryOrder = ["DbServer","DbName","Asset","v_asset_utilization_rollup","v_fuel_efficiency","v_downtime_summary","v_maintenance_status","v_fleet_kpis","MaintenanceFlag","DateTable"]

ref table Asset
ref table v_asset_utilization_rollup
ref table v_fuel_efficiency
ref table v_downtime_summary
ref table v_maintenance_status
ref table v_fleet_kpis
ref table MaintenanceFlag
ref table DateTable
