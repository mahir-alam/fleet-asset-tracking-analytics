# ─────────────────────────────────────────────────────────────────────────────
# Fleet Asset Tracking & Predictive Analytics — environment
# Copy to .env (repo root) for local development.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://fleet:fleet@localhost:5433/fleet?schema=public"
CLIENT_ORIGIN=http://localhost:5173
DASHBOARD_BASE_URL=http://localhost:5173

# Scheduled fleet evaluation (node-cron syntax). Empty = disabled.
# Example: every 15 minutes -> "*/15 * * * *"
EVALUATION_CRON=

# --- IT Help Desk Ticketing integration ---
# Endpoint called: ${TICKET_TRACKER_BASE_URL}/api/tickets/auto-create
# Repo: https://github.com/mahir-alam/it-helpdesk-ticketing-system
#
# INTEGRATION_MODE:
#   mock      - no network; returns a synthetic INC- number, still logs an IntegrationEvent (default when no base URL)
#   live      - real HTTP POST to the ticketing system
#   disabled  - flags are created but no ticket call is attempted
INTEGRATION_MODE=mock
TICKET_TRACKER_BASE_URL=
INTEGRATION_API_KEY=
INTEGRATION_EXTERNAL_SOURCE=fleet-asset-tracker
# Per-attempt timeout, number of attempts, and delay between them. The defaults
# (15000 / 3 / 1500) tolerate a cold-starting tracker on a free hosting tier.
INTEGRATION_TIMEOUT_MS=15000
INTEGRATION_ATTEMPTS=3
INTEGRATION_RETRY_DELAY_MS=1500

# --- Client (Vite) ---
# Leave blank to use the dev proxy (/api -> http://localhost:4000).
VITE_API_BASE_URL=

# --- Python analytics pipeline ---
# Reuses DATABASE_URL above. For a hosted DB, set the full connection string.
FLEET_EXPORT_DIR=data/exports
