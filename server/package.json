{
  "name": "@fleet/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev --name init",
    "prisma:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:views": "dotenv -e ../.env -- prisma db execute --file sql/views.sql --schema prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-reporter spec \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
